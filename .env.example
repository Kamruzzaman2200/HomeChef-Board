# SMTP settings for form notifications (leave empty to only store submissions)
NUXT_SMTP_HOST=smtp.yourprovider.com
NUXT_SMTP_PORT=587
NUXT_SMTP_USER=
NUXT_SMTP_PASS=
NUXT_MAIL_FROM="Northloom Website <no-reply@yourdomain.com>"
NUXT_MAIL_TO=sales@yourdomain.com
# B2B portal links shown in the header/footer
NUXT_PUBLIC_PORTAL_URLS_ORDERS=https://portal.yourdomain.com
NUXT_PUBLIC_PORTAL_URLS_PACKAGING=https://packaging.yourdomain.com
NUXT_PUBLIC_PORTAL_URLS_LABELS=https://labels.yourdomain.com
