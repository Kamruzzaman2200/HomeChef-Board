{
  "name": "homechef-board",
  "version": "1.0.0",
  "private": true,
  "description": "HomeChef Board - Kitchen Order Preparation Management System",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "install:all": "npm install && npm --prefix client install && npm --prefix server install",
    "prisma:generate": "npm --prefix server run prisma:generate",
    "prisma:migrate": "npm --prefix server run prisma:migrate",
    "prisma:deploy": "npm --prefix server run prisma:deploy",
    "prisma:studio": "npm --prefix server run prisma:studio",
    "seed": "npm --prefix server run seed"
  },
  "keywords": ["home-chef", "kitchen-management", "vue3", "express", "prisma", "neon-postgres"]
}
